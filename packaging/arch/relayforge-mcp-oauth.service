[Unit]
Description=RelayForge loopback OAuth MCP resource (explicit opt-in)
After=network-online.target
Wants=network-online.target
ConditionPathExists=%h/.config/relayforge/oauth-tunnel/resource.json

[Service]
Type=simple
LoadCredential=oauth-config:%h/.config/relayforge/oauth-tunnel/resource.json
ExecStart=/usr/bin/env -i HOME=%h PATH=/usr/bin LANG=C.UTF-8 RELAYFORGE_OAUTH_CONFIG_FILE=%d/oauth-config RELAYFORGE_HTTP_PORT=8766 /usr/bin/relayforge-mcp --http-oauth
Restart=on-failure
RestartSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
UMask=0077
TimeoutStopSec=5

[Install]
WantedBy=default.target
