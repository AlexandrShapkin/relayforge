[Unit]
Description=RelayForge local authenticated MCP HTTP endpoint (opt-in)
After=network-online.target
Wants=network-online.target
ConditionPathExists=%h/.config/relayforge/http-token

[Service]
Type=simple
ExecStart=/usr/bin/relayforge-mcp --http
Environment=RELAYFORGE_HTTP_TOKEN_FILE=%h/.config/relayforge/http-token
Environment=RELAYFORGE_HTTP_PORT=8765
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
UMask=0077
TimeoutStopSec=5

[Install]
WantedBy=default.target
