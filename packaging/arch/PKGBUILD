# Canonical package recipe. Build with ci/arch-source.sh from a clean full checkout.
pkgname=relayforge
pkgver=0.1.0
pkgrel=1
pkgdesc='Deny-by-default infrastructure bridge (explicit local authorization required)'
arch=('x86_64')
url='https://github.com/AlexandrShapkin/relayforge'
license=('Apache-2.0')
depends=('glibc' 'gcc-libs' 'systemd' 'python' 'bubblewrap' 'git' 'openssh' 'iproute2')
optdepends=('tunnel-client: independently verified optional Secure MCP Tunnel')
makedepends=('rust' 'licenses')
# A checksummed git archive is created from the exact committed revision, never HOME.
source=('relayforge-source.tar')
sha256sums=('@SOURCE_SHA256@')
# GCC LTO objects from ring/AWS-LC cannot be linked by Rust's LLVM linker.
# Arch Rust package guidelines recommend !lto for these bundled C crates;
# this does not disable Rust's own optimization or other hardening flags.
options=('!strip' '!debug' '!lto')

build() {
    cd "$srcdir"
    export CARGO_TARGET_DIR="$srcdir/target"
    cargo build --release --locked -p relayforge-mcp -p relayforge-agent
}

package() {
    cd "$srcdir"
    install -Dm755 target/release/relayforge-mcp "$pkgdir/usr/bin/relayforge-mcp"
    install -Dm755 target/release/relayforge-agent "$pkgdir/usr/bin/relayforge-agent"
    install -Dm644 packaging/arch/relayforge-mcp-http.service \
        "$pkgdir/usr/lib/systemd/user/relayforge-mcp-http.service"
    install -Dm755 packaging/tunnel.py "$pkgdir/usr/bin/relayforge-tunnel"
    install -Dm644 packaging/arch/relayforge-tunnel.service "$pkgdir/usr/lib/systemd/user/relayforge-tunnel.service"
    install -Dm644 docs/managed-tunnel.md "$pkgdir/usr/share/doc/relayforge/managed-tunnel.md"
    for unit in relayforge-mcp-oauth relayforge-tunnel-http; do
        install -Dm644 "packaging/arch/$unit.service" "$pkgdir/usr/lib/systemd/user/$unit.service"
    done
    install -Dm644 docs/oauth-http.md "$pkgdir/usr/share/doc/relayforge/oauth-http.md"
    for example in resource tunnel; do
        install -Dm644 "packaging/oauth/$example.example.json" "$pkgdir/usr/share/doc/relayforge/$example.example.json"
    done
    install -Dm755 packaging/user_data.py "$pkgdir/usr/bin/relayforge-user-data"
    install -Dm644 packaging/arch/source.json "$pkgdir/usr/share/relayforge/source.json"
    install -Dm644 docs/arch-packaging.md "$pkgdir/usr/share/doc/relayforge/arch-packaging.md"
    install -Dm644 /usr/share/licenses/spdx/Apache-2.0.txt "$pkgdir/usr/share/licenses/relayforge/LICENSE"
}
