[Unit]
Description=RelayForge local authenticated MCP HTTP endpoint
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/Projects/relayforge/target/release/relayforge-mcp --http
Environment=RELAYFORGE_HTTP_TOKEN_FILE=%h/.config/relayforge/http-token
Environment=RELAYFORGE_HTTP_PORT=8765
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
UMask=0077
TimeoutStopSec=5

[Install]
WantedBy=default.target
