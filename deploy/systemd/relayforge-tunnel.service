[Unit]
Description=RelayForge private outbound OpenAI Secure MCP Tunnel
After=network-online.target
Wants=network-online.target
ConditionPathExists=%h/.config/relayforge/tunnel/runtime-key
StartLimitIntervalSec=120
StartLimitBurst=4

[Service]
Type=simple
ExecStart=%h/.local/libexec/relayforge/tunnel-client run --profile relayforge-local --health.listen-addr 127.0.0.1:0 --health.url-file %t/relayforge-tunnel/health.url --control-plane.poll-timeout 6s --control-plane.initial-poll-timeout 6s --control-plane.poll-deadline-guardrail 5s
Restart=on-failure
RestartSec=10
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
RuntimeDirectory=relayforge-tunnel
RuntimeDirectoryMode=0700
ReadWritePaths=%t/relayforge-tunnel %h/.local/state/relayforge
UMask=0077
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=default.target
